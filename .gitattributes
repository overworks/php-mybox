# Keep development-only files out of the distributed package. Consumers get the
# source, the licence and the documentation; not the test suite, the scripts
# that talk to a live account, or the tooling configuration.
/.github            export-ignore
/tests              export-ignore
/tools              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml.dist   export-ignore
/phpstan.neon.dist  export-ignore
/.php-cs-fixer.dist.php export-ignore
/AGENTS.md          export-ignore
/CLAUDE.md          export-ignore
/CONTRIBUTING.md    export-ignore
